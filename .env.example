# Copy this file to .env and fill in your values
# cp .env.example .env

# LLM Provider — Option 1: OpenRouter (e.g. Free Nemotron Ultra / 70B)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# LLM Provider — Option 2: OpenAI Direct
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=frtb_sa_clauses

# Embedding model (sentence-transformers hub name)
EMBED_MODEL=BAAI/bge-large-en-v1.5

# Chunking
MAX_CHUNK_TOKENS=500

# HuggingFace Hub (optional — suppresses rate-limit warnings)
# HF_TOKEN=hf_...
HF_HUB_DISABLE_SYMLINKS_WARNING=1
